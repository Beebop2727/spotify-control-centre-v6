<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.spotify-control-centre" path="/org/gnome/shell/extensions/spotify-control-centre/">

        <key name="position" type="s">
            <default>'left'</default>
            <summary>Panel Position</summary>
        </key>
        <key name="layout-order" type="s">
            <default>'buttons-end'</default>
            <summary>Layout Order</summary>
        </key>
        <key name="show-play-pause" type="b">
            <default>true</default>
        </key>
        <key name="show-prev" type="b">
            <default>true</default>
        </key>
        <key name="show-next" type="b">
            <default>true</default>
        </key>
        <key name="show-panel-title" type="b">
            <default>true</default>
            <summary>Show song title in the top panel</summary>
        </key>
        <key name="show-panel-artist" type="b">
            <default>true</default>
            <summary>Show artist name in the top panel</summary>
        </key>
        <key name="button-spacing" type="i">
            <default>4</default>
        </key>
        <key name="label-margin" type="i">
            <default>6</default>
        </key>
        <key name="panel-label-width" type="i">
            <default>170</default>
            <summary>Fixed width of the track text viewport in the panel</summary>
        </key>
        <key name="marquee-enabled" type="b">
            <default>true</default>
            <summary>Scroll panel text when it exceeds the fixed viewport</summary>
        </key>
        <key name="marquee-speed" type="i">
            <default>36</default>
            <summary>Panel marquee speed in pixels per second</summary>
        </key>


        <!-- Private cache used so the panel can show the last known track
             while Spotify is open but reports PlaybackStatus=Stopped. -->
        <key name="last-track-title" type="s"><default>''</default></key>
        <key name="last-track-artist" type="s"><default>''</default></key>
        <key name="last-track-album" type="s"><default>''</default></key>
        <key name="last-track-art-url" type="s"><default>''</default></key>
        <key name="last-track-id" type="s"><default>''</default></key>
        <key name="last-track-length" type="s"><default>'0'</default></key>

        <key name="bg-mode" type="s">
            <default>'ambient'</default>
        </key>
        <key name="custom-bg-color" type="s">
            <default>'#180f16'</default>
        </key>

        <key name="custom-header-text" type="s">
            <default>'Spotify'</default>
        </key>
        <key name="header-font-size" type="i">
            <default>12</default>
        </key>
        <key name="header-text-color" type="s">
            <default>'#ffffff'</default>
        </key>

        <key name="slider-style" type="s">
            <default>'wavy'</default>
        </key>
        <key name="slider-color" type="s">
            <default>'#ffffff'</default>
        </key>
        <key name="slider-track-color" type="s">
            <default>'rgba(255, 255, 255, 0.30)'</default>
        </key>
        <key name="thumb-color" type="s">
            <default>'#ffffff'</default>
        </key>
        <key name="slider-thickness" type="i">
            <default>4</default>
        </key>
        <key name="thumb-size" type="i">
            <default>8</default>
        </key>
        <key name="thumb-vertical-thickness" type="i">
            <default>4</default>
        </key>
        <key name="wave-speed" type="d">
            <default>0.04</default>
        </key>
        <key name="thumb-style" type="s">
            <default>'round'</default>
        </key>

        <key name="cover-art-size" type="i">
            <default>300</default>
        </key>
        <key name="cover-art-radius" type="i">
            <default>14</default>
        </key>
        <key name="popup-icon-size" type="i">
            <default>24</default>
        </key>
        <key name="art-rotate-speed" type="i">
            <default>0</default>
        </key>

        <key name="popup-button-color" type="s">
            <default>'#ffffff'</default>
        </key>
        <key name="time-text-color" type="s">
            <default>'#ffffff'</default>
        </key>
        <key name="title-text-color" type="s">
            <default>'#ffffff'</default>
        </key>
        <key name="artist-text-color" type="s">
            <default>'#cccccc'</default>
        </key>
        <key name="custom-font-family" type="s">
            <default>''</default>
        </key>
        <key name="title-font-size" type="i">
            <default>16</default>
        </key>
        <key name="artist-font-size" type="i">
            <default>11</default>
        </key>
        <key name="time-font-size" type="i">
            <default>10</default>
        </key>

        <key name="lyrics-active-color" type="s">
            <default>'#ffffff'</default>
        </key>
        <key name="lyrics-active-size" type="i">
            <default>18</default>
        </key>
        <key name="lyrics-neighbor-color" type="s">
            <default>'rgba(255, 255, 255, 0.6)'</default>
        </key>
        <key name="lyrics-neighbor-size" type="i">
            <default>12</default>
        </key>
        <key name="lyrics-inactive-color" type="s">
            <default>'rgba(255, 255, 255, 0.25)'</default>
        </key>
        <key name="lyrics-inactive-size" type="i">
            <default>11</default>
        </key>
        <key name="lyrics-line-spacing" type="i">
            <default>8</default>
        </key>

        <key name="art-pad-top" type="i"><default>12</default></key>
        <key name="art-pad-bottom" type="i"><default>12</default></key>
        <key name="art-pad-left" type="i"><default>12</default></key>
        <key name="art-pad-right" type="i"><default>12</default></key>

        <key name="text-margin-top" type="i"><default>4</default></key>
        <key name="text-margin-bottom" type="i"><default>4</default></key>
        <key name="text-margin-left" type="i"><default>0</default></key>
        <key name="text-margin-right" type="i"><default>0</default></key>

        <key name="slider-pad-top" type="i"><default>0</default></key>
        <key name="slider-pad-bottom" type="i"><default>0</default></key>
        <key name="slider-pad-left" type="i"><default>0</default></key>
        <key name="slider-pad-right" type="i"><default>0</default></key>

        <key name="ctrl-pad-top" type="i"><default>10</default></key>
        <key name="ctrl-pad-bottom" type="i"><default>10</default></key>
        <key name="ctrl-pad-left" type="i"><default>0</default></key>
        <key name="ctrl-pad-right" type="i"><default>0</default></key>

    </schema>
</schemalist>